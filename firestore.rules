rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mindenki csak a saját dokumentumát olvashatja/írhatja (a Google-fiókja azonosítója alatt).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Napi felhő-pillanatképek (users/{uid}/backups/{ÉÉÉÉ-HH-NN}) — adatvesztés esetén
    // ebből lehet visszaállni. Csak a saját fiók éri el. Az app 14 napot tart meg.
    match /users/{uid}/backups/{bakId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
    // Visszajelzés: bárki LÉTREHOZHAT (belépés nélkül is), de senki nem olvashatja/listázhatja
    // az appból — csak a Firebase konzolból. Rövid hosszkorlát spam ellen.
    match /feedback/{doc} {
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 6000;
      allow read, list, update, delete: if false;
    }
    // Közös kvíz-bank: bárki OLVASHATJA (belépés nélkül is); létrehozni csak bejelentkezve,
    // séma-validációval lehet. Módosítás/törlés kliensről TILOS — a dedup azonos dokumentum-
    // id-re (kérdés-hash) írással történik. Opts: 2 (Igaz/Hamis) vagy 4 (feleletválasztós).
    match /quizbank/{chapterId}/questions/{qid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.q is string
        && request.resource.data.q.size() > 0
        && request.resource.data.q.size() < 400
        && request.resource.data.opts is list
        && (request.resource.data.opts.size() == 2 || request.resource.data.opts.size() == 4)
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 3
        && request.resource.data.diff in ['hard','veryhard']
        && request.resource.data.ref is string
        && request.resource.data.ref.size() < 60;
      allow update, delete: if false;
    }
    // KÖZÖS LISTÁK (sharedlists/{listId}/items) — jelenleg egy lista van: "dev",
    // a közös fejlesztési lista (hibák + ötletek), amit mindenki együtt szerkeszt.
    //  - OLVASNI bárki tud, belépés nélkül is. Ez szándékos: így a lista kívülről is
    //    lekérdezhető (a fejlesztéshez), és belépés nélkül is látszik az appban.
    //    Ha ezt később nem akarod: írd át `allow read: if request.auth != null;`-ra.
    //  - ÍRNI csak bejelentkezve lehet, és a létrehozó azonosítója kötelező.
    //  - A lista KÖZÖS: bármelyik belépett felhasználó kipipálhatja/törölheti a tételt.
    //    Ha szűkíteni akarod a kört, vedd elő az alábbi allowlistet:
    //      function tag(){ return request.auth != null && request.auth.uid in
    //        ['UID1','UID2','UID3']; }
    //    és cseréld a `request.auth != null` feltételeket `tag()`-re.
    //
    // 2026-07-29 óta a lista MAGA is dokumentum: sharedlists/{listId} ->
    //   {name, em, kind, emails:[...], owner, at}
    // A tagságot — mint a közös háztartásnál — az E-MAIL CÍM adja, így a
    // meghívott appja magától megtalálja a listát (kód és link nélkül).
    // A "dev" lista KIVÉTEL: az a nyilvános fejlesztési lista, nincs (és nem is
    // kell) hozzá meta-dokumentum, bárki olvashatja, belépve bárki írhatja.
    function devList(listId) { return listId == 'dev'; }
    function listMember(listId) {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email.lower()
            in get(/databases/$(database)/documents/sharedlists/$(listId)).data.emails);
    }
    match /sharedlists/{listId} {
      allow get, list: if devList(listId)
        || (request.auth != null && request.auth.token.email != null
            && (request.auth.token.email.lower() in resource.data.emails));
      allow create: if request.auth != null
        && request.auth.token.email != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.emails is list
        && request.resource.data.emails.size() > 0
        && request.resource.data.emails.size() <= 12
        && (request.auth.token.email.lower() in request.resource.data.emails)
        && request.resource.data.name is string
        && request.resource.data.name.size() < 60;
      // Bármelyik tag átnevezheti a listát és hívhat meg másokat; a tulaj nem írható át.
      allow update: if request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email.lower() in resource.data.emails)
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 12
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /sharedlists/{listId}/items/{itemId} {
      allow read: if devList(listId) || listMember(listId);
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 2000
        && (devList(listId) || listMember(listId));
      // A szerző azonosítója nem írható át (a kipipálás merge-gel megy, így megmarad).
      allow update: if request.auth != null
        && request.resource.data.by == resource.data.by
        && request.resource.data.text is string
        && request.resource.data.text.size() < 2000
        && (devList(listId) || listMember(listId));
      allow delete: if request.auth != null && (devList(listId) || listMember(listId));
    }
    // KÖZÖS HÁZTARTÁS (households/{hid}) — egy háztartás tagjai közösen használják
    // a saját ételeiket és receptjeiket. A tagságot az E-MAIL CÍM adja: aki benne van
    // a `emails` listában, az olvashat/írhat. Így a meghívott appja magától megtalálja
    // a háztartását (users where emails array-contains <saját e-mail>), kód nélkül.
    //  - A NAPLÓ, a célok és a súly NEM kerül ide, csak a közös ételtár.
    //  - A `owner` (a létrehozó uid-je) nem írható át.
    //  - Legfeljebb 12 tag.
    match /households/{hid} {
      function member() {
        return request.auth != null
          && request.auth.token.email != null
          && (request.auth.token.email.lower() in resource.data.emails);
      }
      allow read: if member();
      allow create: if request.auth != null
        && request.auth.token.email != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.emails is list
        && request.resource.data.emails.size() > 0
        && request.resource.data.emails.size() <= 12
        && (request.auth.token.email.lower() in request.resource.data.emails)
        && request.resource.data.name is string
        && request.resource.data.name.size() < 60;
      allow update: if member()
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 12
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // A közös ételtár: saját ételek (t:"f") és receptek (t:"r"), illetve a
      // törlés-sírkövek (del:1). Csak a háztartás tagjai érik el.
      match /lib/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.token.email != null
          && (request.auth.token.email.lower()
              in get(/databases/$(database)/documents/households/$(hid)).data.emails);
      }
    }
    // Kérdés-riport: bárki (belépve) LÉTREHOZHAT; olvasni/listázni nem lehet (konzolos moderálás).
    match /quizreports/{doc} {
      allow create: if request.auth != null
        && request.resource.data.qid is string
        && request.resource.data.qid.size() > 0
        && request.resource.data.qid.size() < 200;
      allow read, list, update, delete: if false;
    }
  }
}
